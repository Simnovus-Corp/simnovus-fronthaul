OCUDU: 100 MHz uplink interop with the Simnovus UE simulator over O-RAN 7.2

At 100 MHz (30 kHz SCS) the cell has 273 PRBs, more than the 8-bit numPrbc field can
count. OCUDU then sends the uplink C-Plane section with numPrbc=0 ("all PRBs"). The
Simnovus UE simulator sends no uplink U-Plane for that section, so PRACH works but the
attach fails at Msg3.

1. lib/ofh/serdes/ofh_cplane_message_builder_impl.cpp: an uplink section wider than
   255 PRBs is sent as two sections (255 PRBs, then the rest) with explicit
   startPrbc/numPrbc. Downlink and narrower sections are unchanged.
2. lib/ofh/ethernet/ethernet_rx_buffer_pool.h: OFH receive buffer pool 4 MB -> 64 MB
   (avoids "No buffer is available for receiving an Ethernet packet" at 80-100 MHz).

Checked to apply to OCUDU release_26_10, release_26_04 and dev (2026-10-27).
From the top of the OCUDU source tree:

    git apply ocudu-100mhz-ul-section-split.patch

then rebuild and restart the gNB.

diff --git a/lib/ofh/ethernet/ethernet_rx_buffer_pool.h b/lib/ofh/ethernet/ethernet_rx_buffer_pool.h
index 60498514e..6e1864e7f 100644
--- a/lib/ofh/ethernet/ethernet_rx_buffer_pool.h
+++ b/lib/ofh/ethernet/ethernet_rx_buffer_pool.h
@@ -19,7 +19,7 @@ namespace ether {
 class ethernet_rx_buffer_pool
 {
   /// Allocate 4MB of storage, evenly divided between Ethernet receive buffers.
-  static constexpr units::bytes ETH_BUFFER_POOL_SIZE{4096000};
+  static constexpr units::bytes ETH_BUFFER_POOL_SIZE{65536000};
 
   using rx_buffer_id_list =
       concurrent_queue<unsigned, concurrent_queue_policy::lockfree_mpmc, concurrent_queue_wait_policy::non_blocking>;
diff --git a/lib/ofh/serdes/ofh_cplane_message_builder_impl.cpp b/lib/ofh/serdes/ofh_cplane_message_builder_impl.cpp
index ad196c508..14a78bd4a 100644
--- a/lib/ofh/serdes/ofh_cplane_message_builder_impl.cpp
+++ b/lib/ofh/serdes/ofh_cplane_message_builder_impl.cpp
@@ -237,8 +237,13 @@ cplane_message_builder_impl::build_dl_ul_radio_channel_message(span<uint8_t>
   // Slot identifier and start symbol (1 Byte).
   serializer.write(encode_slot_and_start_symbol(msg_params.radio_hdr.slot, msg_params.radio_hdr.start_symbol));
 
-  // Only 1 section (1 Byte).
-  serializer.write(uint8_t(1U));
+  // An uplink section wider than 255 PRBs (e.g. 273 PRBs at 100 MHz, 30 kHz) is sent as two sections with explicit
+  // startPrbc/numPrbc instead of one section with numPrbc=0 ("all PRBs"), for O-RUs that need the explicit form
+  // on the uplink (the Simnovus UE simulator sends no uplink U-Plane for an uplink numPrbc=0 section).
+  static constexpr unsigned MAX_NOF_PRBC_PER_SECTION = 255U; // numPrbc is 8 bits; 0 means "all PRBs".
+  const bool split_ul = msg_params.radio_hdr.direction == data_direction::uplink &&
+                        msg_params.section_fields.common_fields.nof_prb > MAX_NOF_PRBC_PER_SECTION;
+  serializer.write(uint8_t(split_ul ? 2U : 1U));
 
   // Section type for DL/UL radio channel is 1 (1 Byte).
   static constexpr uint8_t section_type = 1U;
@@ -251,8 +256,18 @@ cplane_message_builder_impl::build_dl_ul_radio_channel_message(span<uint8_t>
   static constexpr uint8_t reserved = 0U;
   serializer.write(reserved);
 
-  // Write the section fields. Only one section supported.
-  serialize_section_1(serializer, msg_params.section_fields);
+  // Write the section fields: one section, or two for a split uplink section.
+  if (!split_ul) {
+    serialize_section_1(serializer, msg_params.section_fields);
+  } else {
+    cplane_dl_ul_radio_channel_section_fields first  = msg_params.section_fields;
+    cplane_dl_ul_radio_channel_section_fields second = msg_params.section_fields;
+    first.common_fields.nof_prb                      = MAX_NOF_PRBC_PER_SECTION;
+    second.common_fields.prb_start = first.common_fields.prb_start + first.common_fields.nof_prb;
+    second.common_fields.nof_prb   = msg_params.section_fields.common_fields.nof_prb - first.common_fields.nof_prb;
+    serialize_section_1(serializer, first);
+    serialize_section_1(serializer, second);
+  }
 
   return serializer.get_offset();
 }
